{
  "info": {
    "_postman_id": "c81492c3-e8d5-4ac2-9955-bf825313cb37",
    "name": "TP Integrador Clase a Clase - Demo",
    "description": "Collection para demo local del proyecto serverExpress clase a clase. Ejecutar con el environment \"TP Integrador Clase a Clase - Local\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('baseUrl')) {",
          "    pm.environment.set('baseUrl', 'http://localhost:3000');",
          "}",
          "",
          "if (!pm.environment.get('adminUser')) {",
          "    pm.environment.set('adminUser', 'admin_demo_' + Date.now());",
          "}",
          "",
          "if (!pm.environment.get('adminPass')) {",
          "    pm.environment.set('adminPass', 'admin123');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Healthcheck",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Verifica que el servidor Express este levantado."
      },
      "response": []
    },
    {
      "name": "01 - Crear usuario admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Admin Demo\",\n  \"usuario\": \"{{adminUser}}\",\n  \"pass\": \"{{adminPass}}\",\n  \"admin\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        },
        "description": "Crea un usuario administrador para obtener token. Si ya tenes un admin creado, podes saltear este request y ajustar adminUser/adminPass en el environment."
      },
      "response": []
    },
    {
      "name": "02 - Login admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login correcto', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.token) {",
              "    pm.environment.set('token', json.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"{{adminUser}}\",\n  \"pass\": \"{{adminPass}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/usuarios/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios",
            "login"
          ]
        },
        "description": "Devuelve JWT y lo guarda en la variable token."
      },
      "response": []
    },
    {
      "name": "03 - Listar carreras",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/carreras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carreras"
          ]
        },
        "description": "Lista carreras activas, es decir, con fecha de baja null."
      },
      "response": []
    },
    {
      "name": "04 - Crear carrera",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Carrera creada', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.id) {",
              "    pm.environment.set('carreraId', json.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Carrera Demo {{$timestamp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/carreras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carreras"
          ]
        },
        "description": "Requiere token de admin. El middleware agrega idUsuario para auditoria."
      },
      "response": []
    },
    {
      "name": "05 - Modificar carrera",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{carreraId}},\n  \"nombre\": \"Carrera Demo Modificada {{$timestamp}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/carreras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carreras"
          ]
        },
        "description": "Requiere token de admin. Actualiza nombre y auditoria de modificacion."
      },
      "response": []
    },
    {
      "name": "06 - Crear materia",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Materia creada', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "if (json.id) {",
              "    pm.environment.set('materiaId', json.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Materia Demo {{$timestamp}}\",\n  \"carrera\": {{carreraId}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/materias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "materias"
          ]
        },
        "description": "Requiere token de admin. El middleware agrega idUsuario para auditoria."
      },
      "response": []
    },
    {
      "name": "07 - Listar materias",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/materias",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "materias"
          ]
        },
        "description": "Lista materias con su carrera."
      },
      "response": []
    },
    {
      "name": "08 - Listar materias por carrera",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/materias/carrera/{{carreraId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "materias",
            "carrera",
            "{{carreraId}}"
          ]
        },
        "description": "Usa el id de carrera creado en el request 04."
      },
      "response": []
    },
    {
      "name": "09 - Baja logica de carrera",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/carreras/{{carreraId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carreras",
            "{{carreraId}}"
          ]
        },
        "description": "Hace baja logica de carrera, completando usuario y fecha de baja."
      },
      "response": []
    },
    {
      "name": "10 - Ver carreras activas luego de baja",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/carreras",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "carreras"
          ]
        },
        "description": "La carrera dada de baja no deberia aparecer porque car_fechabaja ya no es null."
      },
      "response": []
    }
  ]
}
