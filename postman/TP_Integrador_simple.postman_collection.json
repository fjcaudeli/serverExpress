{
  "info": {
    "name": "TP Integrador - Simple",
    "description": "Collection simple para importar en Postman. Importar como archivo JSON, no como cURL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenCoordinador",
      "value": ""
    },
    {
      "key": "tokenAlumno",
      "value": ""
    },
    {
      "key": "alumnoId",
      "value": "3"
    },
    {
      "key": "materiaId",
      "value": "1"
    },
    {
      "key": "inscripcionId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login admin OK', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('tokenAdmin', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Login - Coordinador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login coordinador OK', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('tokenCoordinador', data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"coordinador\",\n  \"password\": \"coord123\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        },
        {
          "name": "Login - Alumno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login alumno OK', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('tokenAlumno', data.token);",
                  "pm.collectionVariables.set('alumnoId', data.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"alumno\",\n  \"password\": \"alumno123\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        }
      ]
    },
    {
      "name": "Alumnos",
      "item": [
        {
          "name": "Listar alumnos - Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/alumnos"
          }
        },
        {
          "name": "Listar alumnos con bajas - Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/alumnos?todos=true"
          }
        },
        {
          "name": "Ver alumno - Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/alumnos/{{alumnoId}}"
          }
        },
        {
          "name": "Crear alumno - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('alumnoId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Alumno Postman\",\n  \"mail\": \"alumno{{$timestamp}}@postman.com\",\n  \"usuario\": \"alumno_{{$timestamp}}\",\n  \"password\": \"alumno123\"\n}"
            },
            "url": "{{baseUrl}}/alumnos"
          }
        },
        {
          "name": "Editar alumno - Admin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Alumno Postman Editado\"\n}"
            },
            "url": "{{baseUrl}}/alumnos/{{alumnoId}}"
          }
        },
        {
          "name": "Baja logica alumno - Admin",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/alumnos/{{alumnoId}}"
          }
        },
        {
          "name": "Mis datos - Alumno",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlumno}}"
              }
            ],
            "url": "{{baseUrl}}/alumnos/{{alumnoId}}"
          }
        }
      ]
    },
    {
      "name": "Materias",
      "item": [
        {
          "name": "Listar materias - Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/materias"
          }
        },
        {
          "name": "Ver materia - Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/materias/{{materiaId}}"
          }
        },
        {
          "name": "Crear materia - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('materiaId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Materia Postman {{$timestamp}}\",\n  \"carreraId\": 1\n}"
            },
            "url": "{{baseUrl}}/materias"
          }
        },
        {
          "name": "Editar materia - Admin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Materia Postman Editada\"\n}"
            },
            "url": "{{baseUrl}}/materias/{{materiaId}}"
          }
        },
        {
          "name": "Baja logica materia - Admin",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": "{{baseUrl}}/materias/{{materiaId}}"
          }
        },
        {
          "name": "Alumnos de materia - Coordinador",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCoordinador}}"
              }
            ],
            "url": "{{baseUrl}}/materias/{{materiaId}}/alumnos"
          }
        }
      ]
    },
    {
      "name": "Inscripciones",
      "item": [
        {
          "name": "Inscribir alumno - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('inscripcionId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alumnoId\": {{alumnoId}},\n  \"materiaId\": {{materiaId}}\n}"
            },
            "url": "{{baseUrl}}/inscripciones"
          }
        },
        {
          "name": "Inscribirme - Alumno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('inscripcionId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlumno}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"materiaId\": {{materiaId}}\n}"
            },
            "url": "{{baseUrl}}/inscripciones"
          }
        },
        {
          "name": "Materias del alumno - Alumno",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlumno}}"
              }
            ],
            "url": "{{baseUrl}}/alumnos/{{alumnoId}}/materias"
          }
        },
        {
          "name": "Baja inscripcion por id - Admin",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{inscripcionId}}\n}"
            },
            "url": "{{baseUrl}}/inscripciones"
          }
        },
        {
          "name": "Baja inscripcion por alumno y materia - Admin",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alumnoId\": {{alumnoId}},\n  \"materiaId\": {{materiaId}}\n}"
            },
            "url": "{{baseUrl}}/inscripciones"
          }
        }
      ]
    }
  ]
}
